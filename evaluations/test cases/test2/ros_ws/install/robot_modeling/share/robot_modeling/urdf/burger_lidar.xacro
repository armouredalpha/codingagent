<?xml version="1.0"?>
<robot name="turtlebot3_burger" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- BUG: property value must be a quoted string: value="0.5" -->
  <xacro:property name="lidar_height" value=0.5/>

  <link name="base_footprint"/>
  <link name="base_link">
    <visual>
      <geometry><box size="0.14 0.14 0.04"/></geometry>
    </visual>
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.01" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.035" length="0.042"/></geometry>
      <origin xyz="0 0 ${lidar_height}" rpy="0 0 0"/>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="-0.032 0 0.172" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <!-- BUG: plugin tag is missing the name attribute -->
    <sensor type="ray" name="lds_lfcd_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>5</update_rate>
      <plugin filename="libgazebo_ros_laser.so">
        <topicName>scan</topicName>
      </plugin>
    </sensor>
  </gazebo>

</robot>
